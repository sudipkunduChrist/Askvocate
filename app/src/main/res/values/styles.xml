<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== TEXT APPEARANCES ==================== -->

    <style name="TextAppearance.Askvocate.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Askvocate.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Askvocate.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Askvocate.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <!-- ==================== BUTTON STYLES ==================== -->

    <style name="Widget.Askvocate.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="backgroundTint">@color/amber_accent</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Askvocate.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/navy_primary</item>
        <item name="strokeColor">@color/navy_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.Askvocate.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/navy_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="Widget.Askvocate.Button.Small" parent="Widget.Askvocate.Button.Primary">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>

    <!-- ==================== CARD STYLES ==================== -->

    <style name="Widget.Askvocate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <style name="Widget.Askvocate.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== TOOLBAR ==================== -->

    <style name="Widget.Askvocate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_white</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ==================== TEXT INPUT ==================== -->

    <style name="Widget.Askvocate.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ==================== BOTTOM NAVIGATION ==================== -->

    <style name="Widget.Askvocate.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_white</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Askvocate.BottomNavigation.ActiveIndicator</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Askvocate.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/amber_light</item>
    </style>

    <!-- ==================== CHIP ==================== -->

    <style name="Widget.Askvocate.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipBackgroundColor">@color/chip_unselected_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/border_light</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- ==================== FAB ==================== -->

    <style name="Widget.Askvocate.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/amber_accent</item>
        <item name="tint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Askvocate.FAB</item>
    </style>

    <style name="ShapeAppearance.Askvocate.FAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- ==================== NAVIGATION VIEW ==================== -->

    <style name="Widget.Askvocate.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/surface_white</item>
        <item name="itemTextColor">@color/text_primary</item>
        <item name="itemIconTint">@color/navy_primary</item>
    </style>

    <!-- ==================== PREMIUM TEXT APPEARANCES ==================== -->

    <style name="TextAppearance.Premium.Justitia" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">Libre Caslon Text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:textColor">@color/justitia_on_secondary</item>
    </style>

    <style name="TextAppearance.Premium.HeadlineLg" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">Libre Caslon Text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/justitia_on_background</item>
    </style>

    <style name="TextAppearance.Premium.HeadlineMd" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">Libre Caslon Text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/justitia_slate_text</item>
    </style>

    <style name="TextAppearance.Premium.BodyMd" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">Inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/justitia_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Premium.BodySm" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">Inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/justitia_on_surface_variant</item>
    </style>

    <!-- ==================== PREMIUM BUTTON STYLES ==================== -->

    <style name="Widget.Premium.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/justitia_primary_container</item>
        <item name="android:textColor">@color/justitia_on_secondary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:fontFamily">Inter</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Premium.Button.3D" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/justitia_secondary_container</item>
        <item name="android:textColor">@color/justitia_on_secondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">Inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
    </style>

    <!-- ==================== HOME REDESIGN TEXT ==================== -->

    <style name="TextAppearance.Askvocate.HomeHeader" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/home_section_header</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.HomeLink" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/amber_accent</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.Greeting" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/home_blue</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.Askvocate.HomeTitleSerif" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy_primary</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <!-- ==================== HOME CHIP / PILL ==================== -->

    <style name="AskvocateHomeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_home_chip_unselected</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">@color/navy_primary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AskvocateHomeCategoryPill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_category_pill_unselected</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColor">@color/pill_unselected_text</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ==================== PREMIUM CARD STYLE ==================== -->

    <style name="Widget.Premium.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/justitia_surface_elevated</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/justitia_border</item>
        <item name="android:stateListAnimator">@animator/card_lift</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/justitia_shadow_glow</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/justitia_shadow_glow</item>
    </style>

</resources>
