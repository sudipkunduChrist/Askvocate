<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== TEXT APPEARANCES ==================== -->

    <style name="TextAppearance.Askvocate.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Askvocate.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Askvocate.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Askvocate.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Askvocate.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- ==================== BUTTON STYLES ==================== -->

    <style name="Widget.Askvocate.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="backgroundTint">@color/amber_accent</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Askvocate.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/navy_primary</item>
        <item name="strokeColor">@color/navy_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.Askvocate.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/navy_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="Widget.Askvocate.Button.Small" parent="Widget.Askvocate.Button.Primary">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>

    <!-- ==================== CARD STYLES ==================== -->

    <style name="Widget.Askvocate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <style name="Widget.Askvocate.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== TOOLBAR ==================== -->

    <style name="Widget.Askvocate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_white</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ==================== TEXT INPUT ==================== -->

    <style name="Widget.Askvocate.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ==================== BOTTOM NAVIGATION ==================== -->

    <style name="Widget.Askvocate.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_white</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Askvocate.BottomNavigation.ActiveIndicator</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Askvocate.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/amber_light</item>
    </style>

    <!-- ==================== CHIP ==================== -->

    <style name="Widget.Askvocate.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipBackgroundColor">@color/chip_unselected_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/border_light</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- ==================== FAB ==================== -->

    <style name="Widget.Askvocate.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/amber_accent</item>
        <item name="tint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Askvocate.FAB</item>
    </style>

    <style name="ShapeAppearance.Askvocate.FAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- ==================== NAVIGATION VIEW ==================== -->

    <style name="Widget.Askvocate.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/surface_white</item>
        <item name="itemTextColor">@color/text_primary</item>
        <item name="itemIconTint">@color/navy_primary</item>
    </style>

</resources>
