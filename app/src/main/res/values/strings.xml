    <!-- Privacy Policy -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="last_updated">Last updated: August 2026</string>
    <string name="privacy_intro">At Askvocate, we take your privacy seriously. This policy describes how we collect, use, and protect your personal information when you use our legal services platform.</string>
    <string name="info_collection_title">1. Information We Collect</string>
    <string name="info_collection_body">We collect information you provide directly, including your name, email address, phone number, and any details shared during consultations. We also collect usage data such as app interactions and device information to improve our services.</string>
    <string name="info_use_title">2. How We Use Your Information</string>
    <string name="info_use_body">Your information is used to connect you with qualified legal professionals, facilitate consultations, process payments, and improve our platform. We never share your consultation details with third parties without your explicit consent.</string>
    <string name="data_security_title">3. Data Security</string>
    <string name="data_security_body">We employ industry-standard encryption and security measures to protect your personal data. All communications between you and your lawyer are end-to-end encrypted to ensure confidentiality.</string>
    <string name="your_rights_title">4. Your Rights</string>
    <string name="your_rights_body">You have the right to access, update, or delete your personal data at any time. You may also opt out of non-essential communications. Contact our support team for any privacy-related requests.</string>
    <string name="contact_us_title">5. Contact Us</string>
    <string name="contact_us_body">If you have questions about this Privacy Policy, please contact us at privacy@askvocate.com or through the in-app support feature.</string>

