<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_splash">

    <fragment
        android:id="@+id/nav_splash"
        android:name="com.example.askvocate.ui.auth.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_role_selection"
            app:destination="@id/nav_role_selection"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_splash"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_role_selection"
        android:name="com.example.askvocate.ui.auth.RoleSelectionFragment"
        android:label="Role Selection"
        tools:layout="@layout/fragment_role_selection">
        <action
            android:id="@+id/action_role_selection_to_onboarding"
            app:destination="@id/nav_onboarding"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_onboarding"
        android:name="com.example.askvocate.ui.auth.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <argument
            android:name="isLawyer"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_onboarding_to_sign_up"
            app:destination="@id/nav_sign_up"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_onboarding_to_lawyer_sign_up"
            app:destination="@id/nav_lawyer_sign_up"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_get_started"
        android:name="com.example.askvocate.ui.auth.GetStartedFragment"
        android:label="Get Started"
        tools:layout="@layout/fragment_get_started">
        <action
            android:id="@+id/action_get_started_to_sign_in"
            app:destination="@id/nav_sign_in"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_get_started_to_sign_up"
            app:destination="@id/nav_sign_up"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popUpTo="@id/nav_role_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_sign_in"
        android:name="com.example.askvocate.ui.auth.SignInFragment"
        android:label="@string/sign_in"
        tools:layout="@layout/fragment_sign_in">
        <argument
            android:name="isLawyer"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_sign_in_to_sign_up"
            app:destination="@id/nav_sign_up"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/nav_sign_in"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_sign_in_to_lawyer_sign_up"
            app:destination="@id/nav_lawyer_sign_up"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/nav_sign_in"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_sign_in_to_role_selection"
            app:destination="@id/nav_role_selection"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popUpTo="@id/nav_role_selection"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_sign_in_to_home"
            app:destination="@id/nav_home"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_role_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_sign_up"
        android:name="com.example.askvocate.ui.auth.SignUpFragment"
        android:label="@string/sign_up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_sign_up_to_sign_in"
            app:destination="@id/nav_sign_in"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/nav_sign_up"
            app:popUpToInclusive="true">
            <argument
                android:name="isLawyer"
                android:defaultValue="false" />
        </action>
        <action
            android:id="@+id/action_sign_up_to_home"
            app:destination="@id/nav_home"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_role_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_lawyer_sign_up"
        android:name="com.example.askvocate.ui.auth.LawyerSignUpFragment"
        android:label="Lawyer Sign Up"
        tools:layout="@layout/fragment_lawyer_sign_up">
        <action
            android:id="@+id/action_lawyer_sign_up_to_sign_in"
            app:destination="@id/nav_sign_in"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/nav_lawyer_sign_up"
            app:popUpToInclusive="true">
            <argument
                android:name="isLawyer"
                android:defaultValue="true" />
        </action>
        <action
            android:id="@+id/action_lawyer_sign_up_to_home"
            app:destination="@id/nav_home"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_role_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.askvocate.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_lawyer_profile"
            app:destination="@id/nav_lawyer_profile"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_find_lawyers"
        android:name="com.example.askvocate.ui.findlawyers.FindLawyersFragment"
        android:label="@string/nav_find_lawyers"
        tools:layout="@layout/fragment_find_lawyers">
        <action
            android:id="@+id/action_find_lawyers_to_lawyer_profile"
            app:destination="@id/nav_lawyer_profile"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_chat_list"
        android:name="com.example.askvocate.ui.chat.ChatListFragment"
        android:label="@string/nav_chat"
        tools:layout="@layout/fragment_chat_list">
        <action
            android:id="@+id/action_chat_list_to_chat_detail"
            app:destination="@id/nav_chat_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_client_profile"
        android:name="com.example.askvocate.ui.clientprofile.ClientProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_client_profile" />

    <fragment
        android:id="@+id/nav_map"
        android:name="com.example.askvocate.ui.map.MapFragment"
        android:label="@string/nav_map"
        tools:layout="@layout/fragment_map">
        <action
            android:id="@+id/action_map_to_lawyer_profile"
            app:destination="@id/nav_lawyer_profile"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_privacy_policy"
        android:name="com.example.askvocate.ui.privacy.PrivacyPolicyFragment"
        android:label="@string/nav_privacy_policy"
        tools:layout="@layout/fragment_privacy_policy" />

    <fragment
        android:id="@+id/nav_lawyer_profile"
        android:name="com.example.askvocate.ui.lawyerprofile.LawyerProfileFragment"
        android:label="Lawyer Profile"
        tools:layout="@layout/fragment_lawyer_profile">
        <argument
            android:name="lawyerId"
            app:argType="string" />
        <action
            android:id="@+id/action_lawyer_profile_to_chat_detail"
            app:destination="@id/nav_chat_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/nav_chat_detail"
        android:name="com.example.askvocate.ui.chat.ChatDetailFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat_detail">
        <argument
            android:name="chatId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_appointments"
        android:name="com.example.askvocate.ui.appointments.AppointmentsFragment"
        android:label="@string/nav_appointments"
        tools:layout="@layout/fragment_appointments" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.askvocate.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
