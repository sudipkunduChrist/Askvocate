<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingBottom="@dimen/spacing_md">

    <TextView
        android:id="@+id/tv_assistant_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_legal_assistant_user"
        android:lineSpacingExtra="2dp"
        android:maxWidth="300dp"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="10dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        tools:text="Mera traffic challan galat issue hua hai." />

    <TextView
        android:id="@+id/tv_assistant_user_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        tools:text="9:15 PM" />
</LinearLayout>
