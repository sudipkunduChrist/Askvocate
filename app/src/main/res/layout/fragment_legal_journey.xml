<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/justitia_bg">

    <!-- Hero Background -->
    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_journey_hero"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_pattern_geometric"
        android:alpha="0.2"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        android:paddingTop="12dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/askvocate"
                android:textAppearance="@style/TextAppearance.Premium.Justitia"
                android:textColor="@color/white" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:background="@color/justitia_bg"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="120dp">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.Premium.HeadlineLg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Your Legal Journey"
                android:textColor="@color/journey_text_headline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.8" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.Premium.BodyMd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Experience a seamless, secure, and intelligent path to resolving your legal matters."
                android:textColor="@color/journey_text_body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintWidth_percent="0.8" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/timeline_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- Timeline Line -->

            <!-- STEP 1: LEFT -->
            <include
                android:id="@+id/item1"
                layout="@layout/layout_journey_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

            <FrameLayout
                android:id="@+id/icon1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_timeline_check"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/item1"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toTopOf="@id/item1">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_verified_user"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- STEP 2: RIGHT -->
            <include
                android:id="@+id/item2"
                layout="@layout/layout_journey_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/timeline_guideline"
                app:layout_constraintTop_toBottomOf="@id/item1" />

            <FrameLayout
                android:id="@+id/icon2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_timeline_check"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/item2"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toTopOf="@id/item2">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_verified_user"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- STEP 3: LEFT -->
            <include
                android:id="@+id/item3"
                layout="@layout/layout_journey_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item2" />

            <FrameLayout
                android:id="@+id/icon3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_timeline_dot"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/item3"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toTopOf="@id/item3">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_timeline_dot"
                    android:backgroundTint="@color/justitia_on_surface_variant" />
            </FrameLayout>

            <!-- STEP 4: RIGHT -->
            <View
                android:id="@+id/timeline_line"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginTop="60dp"
                android:alpha="0.2"
                android:background="@color/justitia_secondary_container"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintVertical_bias="1.0" />

            <include
                android:id="@+id/item4"
                layout="@layout/layout_journey_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/timeline_guideline"
                app:layout_constraintTop_toBottomOf="@id/item3" />

            <FrameLayout
                android:id="@+id/icon4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_timeline_dot"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/item4"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toTopOf="@id/item4">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_timeline_dot"
                    android:backgroundTint="@color/justitia_on_surface_variant" />
            </FrameLayout>

            <!-- STEP 5: LEFT -->
            <include
                android:id="@+id/item5"
                layout="@layout/layout_journey_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item4" />

            <FrameLayout
                android:id="@+id/icon5"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_timeline_dot"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/item5"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toTopOf="@id/item5">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_timeline_dot"
                    android:backgroundTint="@color/justitia_on_surface_variant" />
            </FrameLayout>

            <!-- STEP 6: RIGHT -->
            <include
                android:id="@+id/item6"
                layout="@layout/layout_journey_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/timeline_guideline"
                app:layout_constraintTop_toBottomOf="@id/item5" />

            <FrameLayout
                android:id="@+id/icon6"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_timeline_dot"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/item6"
                app:layout_constraintEnd_toEndOf="@id/timeline_guideline"
                app:layout_constraintStart_toStartOf="@id/timeline_guideline"
                app:layout_constraintTop_toTopOf="@id/item6">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_timeline_dot"
                    android:backgroundTint="@color/justitia_on_surface_variant" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/justitia_bg"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Widget.Premium.Button.3D"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="220dp"
            android:text="START YOUR CASE"
            android:letterSpacing="0.2"
            android:textSize="14sp"
            android:background="@drawable/bg_button_3d"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_logo"
            app:iconGravity="textStart"
            android:textColor="@color/justitia_on_secondary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>