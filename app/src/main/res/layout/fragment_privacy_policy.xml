<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/privacy_policy_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/last_updated"
                android:textAppearance="@style/TextAppearance.Askvocate.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:lineSpacingExtra="4dp"
                android:text="@string/privacy_intro"
                android:textAppearance="@style/TextAppearance.Askvocate.Body" />

            <!-- Section 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/info_collection_title"
                android:textAppearance="@style/TextAppearance.Askvocate.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:lineSpacingExtra="4dp"
                android:text="@string/info_collection_body"
                android:textAppearance="@style/TextAppearance.Askvocate.Body"
                android:textColor="@color/text_secondary" />

            <!-- Section 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/info_use_title"
                android:textAppearance="@style/TextAppearance.Askvocate.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:lineSpacingExtra="4dp"
                android:text="@string/info_use_body"
                android:textAppearance="@style/TextAppearance.Askvocate.Body"
                android:textColor="@color/text_secondary" />

            <!-- Section 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/data_security_title"
                android:textAppearance="@style/TextAppearance.Askvocate.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:lineSpacingExtra="4dp"
                android:text="@string/data_security_body"
                android:textAppearance="@style/TextAppearance.Askvocate.Body"
                android:textColor="@color/text_secondary" />
                
            <!-- Section 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/your_rights_title"
                android:textAppearance="@style/TextAppearance.Askvocate.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:lineSpacingExtra="4dp"
                android:text="@string/your_rights_body"
                android:textAppearance="@style/TextAppearance.Askvocate.Body"
                android:textColor="@color/text_secondary" />
                
            <!-- Section 5 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/contact_us_title"
                android:textAppearance="@style/TextAppearance.Askvocate.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xxxl"
                android:lineSpacingExtra="4dp"
                android:text="@string/contact_us_body"
                android:textAppearance="@style/TextAppearance.Askvocate.Body"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
