<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_cream"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/spacing_lg">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="100dp"
                    android:layout_height="32dp"
                    android:src="@drawable/app_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:textAppearance="@style/TextAppearance.Askvocate.Label"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_notifications"
                    app:layout_constraintStart_toEndOf="@id/iv_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Good to see you, Sudip" />

                <FrameLayout
                    android:id="@+id/btn_notifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_notifications"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/navy_primary" />

                    <View
                        android:id="@+id/notification_indicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_timeline_dot"
                        android:backgroundTint="@color/error_red"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Askvocate.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/navy_primary"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        android:id="@+id/tv_hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/legal_assistance_simplified"
                        android:textAppearance="@style/TextAppearance.Askvocate.Headline"
                        android:textColor="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_hero_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/hero_subtitle"
                        android:textAppearance="@style/TextAppearance.Askvocate.Body"
                        android:textColor="#CCFFFFFF"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_find_lawyer_hero"
                        style="@style/Widget.Askvocate.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/find_lawyer"
                        app:backgroundTint="@color/amber_accent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_subtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ask_ai_hero"
                        style="@style/Widget.Askvocate.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/ask_ai"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="@id/btn_find_lawyer_hero"
                        app:layout_constraintStart_toEndOf="@id/btn_find_lawyer_hero"
                        app:layout_constraintTop_toTopOf="@id/btn_find_lawyer_hero" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Experience -->
            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xxl"
                android:background="@drawable/bg_search_bar"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/cd_search"
                    app:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_placeholder"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:autofillHints="none"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Askvocate.Body"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <ImageView
                    android:id="@+id/btn_filter"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    android:src="@drawable/ic_filter"
                    android:contentDescription="@string/cd_filter_options"
                    app:tint="@color/navy_primary" />
            </LinearLayout>

            <!-- Quick Actions -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xxl"
                android:columnCount="4">

                <!-- Action 1: Advocates -->
                <LinearLayout
                    android:id="@+id/action_find_lawyer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lawyer"
                        android:contentDescription="@null"
                        app:tint="@color/navy_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/action_advocates"
                        android:textAppearance="@style/TextAppearance.Askvocate.Caption"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Action 2: AI Assistant -->
                <LinearLayout
                    android:id="@+id/action_ask_ai"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_psychology"
                        android:contentDescription="@null"
                        app:tint="@color/navy_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ask_ai"
                        android:textAppearance="@style/TextAppearance.Askvocate.Caption"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Action 3: Appointments -->
                <LinearLayout
                    android:id="@+id/action_appointments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_onboard_consultation"
                        android:contentDescription="@null"
                        app:tint="@color/navy_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/my_appointments_short"
                        android:textAppearance="@style/TextAppearance.Askvocate.Caption"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Action 4: My Documents -->
                <LinearLayout
                    android:id="@+id/action_documents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_description"
                        android:contentDescription="@null"
                        app:tint="@color/navy_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/legal_documents"
                        android:textAppearance="@style/TextAppearance.Askvocate.Caption"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </GridLayout>

            <!-- Upcoming Consultations (Conditional) -->
            <LinearLayout
                android:id="@+id/upcoming_consultations_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_lg"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/upcoming_consultations"
                    android:textAppearance="@style/TextAppearance.Askvocate.Title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_appointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_appointment_card" />
            </LinearLayout>

            <!-- Legal Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/explore_legal_services"
                    android:textAppearance="@style/TextAppearance.Askvocate.Title"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/btn_view_all_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_all"
                    android:textAppearance="@style/TextAppearance.Askvocate.Body"
                    android:textColor="@color/amber_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_lg"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_category_chip" />

            <!-- Top Rated Lawyers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/top_rated_lawyers"
                    android:textAppearance="@style/TextAppearance.Askvocate.Title"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/btn_see_all_lawyers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textAppearance="@style/TextAppearance.Askvocate.Body"
                    android:textColor="@color/amber_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_top_lawyers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_lg"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_lawyer_horizontal" />

            <!-- AI Legal Assistant Promo -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Askvocate.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/transparent"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_promo"
                    android:padding="@dimen/spacing_xl">

                    <ImageView
                        android:id="@+id/iv_ai_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_psychology"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_ai_promo_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/have_legal_question"
                        android:textAppearance="@style/TextAppearance.Askvocate.Title"
                        android:textColor="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_ai_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_ai_icon" />

                    <TextView
                        android:id="@+id/tv_ai_promo_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ai_assistant_promo_desc"
                        android:textAppearance="@style/TextAppearance.Askvocate.Caption"
                        android:textColor="#E0E0E0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tv_ai_promo_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_ai_promo_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_ai_chat"
                        style="@style/Widget.Askvocate.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/start_ai_chat"
                        app:backgroundTint="@color/amber_accent"
                        app:layout_constraintStart_toStartOf="@id/tv_ai_promo_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_ai_promo_desc" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:alpha="0.6"
                        android:text="@string/ai_disclaimer"
                        android:textAppearance="@style/TextAppearance.Askvocate.Caption"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btn_start_ai_chat" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Legal Insights -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/legal_knowledge_hub"
                android:textAppearance="@style/TextAppearance.Askvocate.Title"
                android:textColor="@color/text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_knowledge_hub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_lg"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_knowledge_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
