<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Page counter — "5/5" top-left beside back button -->
    <TextView
        android:id="@+id/tv_page_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="56dp"
        android:text="5/5"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        "Let's start exploring" — centered, large, bold serif-style.
        Vertically biased to sit roughly 35% down the screen (matching reference).
    -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:gravity="center"
        android:text="@string/onboarding_final_title"
        android:textColor="@color/navy_dark"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_get_started_final"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintVertical_chainStyle="packed" />

    <!--
        "Get Started" — solid NAVY pill button at the bottom, matching reference.
        The reference photo shows a dark navy blue button (NOT amber).
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_get_started_final"
        style="@style/Widget.Askvocate.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="88dp"
        android:text="@string/get_started"
        android:textColor="@color/white"
        app:backgroundTint="@color/navy_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
