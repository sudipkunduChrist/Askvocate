<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <View
        android:id="@+id/ambient_shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.04"
        android:background="@color/splash_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <FrameLayout
            android:id="@+id/fl_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo"
                android:scaleType="fitCenter"
                android:alpha="0.9" />

            <!-- Sheen overlay placeholder -->
            <View
                android:id="@+id/view_sheen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/app_logo"
                android:backgroundTint="@color/splash_primary"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AskVocate"
            android:textAppearance="@style/TextAppearance.Askvocate.LabelBold"
            android:textColor="@color/splash_primary"
            android:textSize="18sp"
            android:textAllCaps="true"
            android:letterSpacing="0.3"
            android:alpha="0"
            tools:alpha="1" />

        <LinearLayout
            android:id="@+id/tagline_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:gravity="center"
            android:orientation="horizontal"
            tools:alpha="0.6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find"
                android:textAppearance="@style/TextAppearance.Askvocate.Tagline"
                android:textColor="@color/splash_text"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="●"
                android:textColor="@color/splash_primary"
                android:textSize="6sp"
                android:alpha="0.4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:textAppearance="@style/TextAppearance.Askvocate.Tagline"
                android:textColor="@color/splash_text"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="●"
                android:textColor="@color/splash_primary"
                android:textSize="6sp"
                android:alpha="0.4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get Legal Help"
                android:textAppearance="@style/TextAppearance.Askvocate.Tagline"
                android:textColor="@color/splash_text"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="128dp"
        android:layout_height="1dp"
        android:layout_marginBottom="48dp"
        android:alpha="0"
        android:background="#1A000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:alpha="1">

        <View
            android:id="@+id/progress_sheen"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@color/splash_primary" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>