<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow is reduced -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/justitia_secondary_shadow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Top Solid Layer is pushed down -->
            <item android:bottom="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/justitia_secondary_container" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default State -->
    <item>
        <layer-list>
            <!-- Hard Bottom Shadow (8dp/px approximated) -->
            <item android:top="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/justitia_secondary_shadow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Top Solid Layer -->
            <item android:bottom="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/justitia_secondary_container" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>