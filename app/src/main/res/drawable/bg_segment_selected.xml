<?xml version="1.0" encoding="utf-8"?>
<!-- Selected segment pill: solid royal blue with elevation shadow effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle shadow layer -->
    <item
        android:left="1dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>
    <!-- Main royal blue pill -->
    <item
        android:bottom="2dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@color/navy_primary" />
        </shape>
    </item>
</layer-list>
