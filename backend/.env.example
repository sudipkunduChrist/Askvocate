# MongoDB connection
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/askvocate

# AWS S3 (file storage)
# Create an IAM user with AmazonS3FullAccess (or a scoped policy for your bucket)
# and generate Access Key credentials in the AWS Console.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS region where your S3 bucket is located (e.g. ap-south-1, us-east-1)
AWS_S3_REGION=ap-south-1
# The S3 bucket name to store uploaded documents and selfies
AWS_S3_BUCKET_NAME=your-askvocate-bucket-name
# Duration (in days, 1 to 7) for pre-signed URLs stored in MongoDB
AWS_S3_PRESIGN_DURATION_DAYS=7

# Google OAuth (must match the value in app/.env)
GOOGLE_WEB_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# JWT / app sessions
JWT_SECRET=your_long_random_secret

# Admin review console password (default: askvocate-admin)
ADMIN_PASSWORD=your_admin_password

# Enables keyed duplicate hashes for Aadhaar/PAN/enrollment numbers
AADHAAR_HASH_KEY=your_random_hash_key

# BigDataCloud (geolocation)
BIGDATACLOUD_DEVELOPMENT_ENABLED=true
BIGDATACLOUD_API_KEY=your_bigdatacloud_api_key

# Optional verification worker overrides
# VERIFICATION_PYTHON=C:\Path\To\python.exe
# VERIFICATION_WORKER_PATH=D:\Askvocate\backend\verification\worker.py

# Law degree BCI institution registry (versioned JSON ships with the backend)
# Set DEGREE_ALLOWLIST_ENABLED=false to skip the recognition check, or point
# DEGREE_REGISTRY_PATH at an operator-maintained JSON override.
DEGREE_ALLOWLIST_ENABLED=true
# DEGREE_REGISTRY_PATH=D:\Askvocate\backend\verification\bci-institutions.json

# Advocate Verification API (Option 2: Sandbox.co.in / Surepass / Smart High-Fidelity Simulation)
# When SANDBOX_API_KEY is blank, the system automatically uses smart simulation mode.
BAR_COUNCIL_API_ENABLED=true
SANDBOX_API_KEY=
BAR_COUNCIL_API_URL=https://api.sandbox.co.in/kyc/advocate/verify
